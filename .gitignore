__pycache__/
*.pyc
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Retrieved source, clones and execution artefacts. These are reproducible from
# the pinned citations with `python scripts/fetch_sources.py`, and several
# contain source that must NOT be redistributed. Nothing in work/ belongs in the
# repository; the dataset keeps citations and hashes, not the code.
work/

# Generated at build time, committed deliberately: see reports/.

# Machine-LOCAL run snapshot, deliberately NOT committed. The per-check
# PASS/SKIP split depends on whether the git-ignored inputs are present: a
# checkout with V3/clones/ and work/ runs the derived/ rebuild-parity gate,
# a fresh CI clone skips it. Committing one machine's split makes the
# published report stale everywhere else. The deterministic, committed
# summary is reports/reproducibility_report.md; this file is the live
# matrix for whoever ran it. Enforced by scripts/check_reproducibility.py.
reports/reproducibility_checks.json

# V3 third-party clones (~3 GB, PDF-heavy, must NOT be redistributed).
# The harvester reads them from disk; provenance survives via clone-HEAD pins
# + file sha256 in jsonl_v3/derived_v3. Only the manifest + research docs are
# tracked (negations below).
V3/clones/*
!V3/clones/MANIFEST.md

# Local-only Solodit scrape artefacts (verbatim third-party finding prose,
# must NOT be redistributed). The harvester reads them from disk; only
# structured attributed facts enter Vbeta/. Declared-ignored paths are
# enforced by scripts/check_reproducibility.py — a path listed here must
# never appear in `git ls-files`.
nextdata/
.firecrawl/

# Local tool markers and marketing media. brag-output/ held generated video
# plus third-party audio SFX with no licence in this repo; if the video is
# wanted, keep it outside the repository and link to it.
.freebuff/
brag-output/

# Operator-local model-training scratch (ad-hoc scripts, prompt drafts and
# generated training JSONL). Not part of the dataset; nothing here is read
# by the pipeline or the gates.
ai/

# PEP 517 build artefacts: regenerable with `python -m build`, never source.
build/
dist/
*.egg-info/
# Local agent/tooling caches created on the operator's machine. Neither is read
# by the pipeline, and both contain machine-specific state, so they must never
# enter the committed JSON catalog.
graphify-out/
.opencode/

# Machine-local git-status snapshot written by validate_v31.py. It records what this checkout has in flight, so committing it would make a generated gate artefact change on every run.
reports/v3/validation_v31_worktree.json
