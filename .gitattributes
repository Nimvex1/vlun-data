# Every tracked text file is checked out as LF on every platform, including
# extensionless files (LICENSE, .gitignore). Per-extension rules below are
# kept for clarity; the execution-evidence directories stay untranslated.
* text=auto eol=lf

# Data files are committed with LF. Without this, Windows checkouts rewrite the
# whole dataset to CRLF and every file shows as modified, which hides real edits
# and makes the repository impossible to review.
*.jsonl   text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.csv     text eol=lf
*.py      text eol=lf
*.sol     text eol=lf
*.toml    text eol=lf
*.txt     text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.cff     text eol=lf

# Generated markdown and json: same LF rule, stated explicitly because these
# are the files whose line endings flip byte-identity gates. Writers pass
# newline="\n"; scripts/check_line_endings.py fails the build on CRLF.
reports/**/*.md      text eol=lf
reports/**/*.json    text eol=lf
docs/*.md            text eol=lf
*.cff                text eol=lf

# Verbatim execution evidence: stored exactly as the tool emitted it,
# never newline-translated. forge's own output is part of the artefact,
# and its recorded sha256 must keep matching on every platform.
experiments/**            -text
experiments_v2_2/**       -text
experiments_v3/**         -text

# Binary artefacts of the execution pipeline are not committed.
*.failed  binary