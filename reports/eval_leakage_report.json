  "generated_by": "scripts/build_eval_leakage_report.py",
  "method": {
    "code_overlap": "exact code snippet bytes, snippets normalised for comments, literals and numbers, source file paths, and commit shas. An identical (or reformatting-invariant) snippet means the held-out task's evidence is in the training corpus and is counted as leakage. A shared file path or commit sha only means the same repository or revision was mined, which is provenance, and is reported separately.",
    "expected_train_overlap": "rows in a family's train partition share records with the training corpus by construction. That is the training data, not leakage; only the held-out partitions are defects.",
    "id_overlap": "benchmark identifiers (task id, record id, finding id, the source block, and the input's own finding id) against training identifiers (canonical_record_id, canonical_id, provenance.record_ref, example_id, id, task_id). A '::'-suffixed family prefix is stripped so 'A::test::x' and 'x' compare equal.",
    "label_overlap": "for a benchmark row whose id also appears in the corpus, the answer-key fields are compared with the training row's supervised targets. The value mapping between the two vocabularies is derived from the family's TRAIN partition, never hand-written.",
    "model_visible_corpus": "every .jsonl under training/. A corpus consumer globs a directory, so anything inside training/ is reachable; evaluation-side shards therefore live outside it.",
    "protected_evaluation_set": "every row of every benchmark family whose split is test or validation. A record is protected if ANY family holds it out, because the split systems differ per layer (v1 splits_v2, v2.2 splits_v2_2, v3 splits_v3, vbeta by-source) and one record can be train in one and held out in another.",
    "text_overlap": "the model-facing payload, normalised to lowercase alphanumeric tokens, compared as ordered 8-word shingles. A row overlaps when min(|A|,|B|) containment of the shingle sets is >= 0.9, or when the normalised text is identical. Text shorter than 8 tokens is not compared.",
    "thresholds": {
      "max_candidates": 400,
      "max_shingle_posting": 2000,
      "min_text_tokens": 8,
      "shingle_words": 8,
      "text_containment": 0.9
    }
  },
  "model_visible_corpus_hygiene": {
